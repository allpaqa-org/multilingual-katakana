{
  "name": "@allpaqa/multilingual-katakana",
  "version": "0.4.0",
  "description": "Zero-dependency multilingual foreign language to Japanese Katakana phonetic converter",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.browser.js",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "imports": {
    "#native-backend": {
      "node": "./src/backend/loader.ts",
      "default": "./src/backend/loader.browser.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check:ci": "biome check ."
  },
  "keywords": [
    "katakana",
    "tts",
    "japanese",
    "multilingual",
    "phonetics",
    "twitch",
    "streaming",
    "youtube",
    "discord"
  ],
  "author": "allpaqa",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allpaqa-org/multilingual-katakana.git",
    "directory": "bindings/node"
  },
  "homepage": "https://github.com/allpaqa-org/multilingual-katakana#readme",
  "bugs": {
    "url": "https://github.com/allpaqa-org/multilingual-katakana/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  }
}
