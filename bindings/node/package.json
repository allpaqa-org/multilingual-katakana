{
  "name": "@allpaqa/multilingual-katakana",
  "version": "0.1.0",
  "description": "Zero-dependency multilingual foreign language to Japanese Katakana phonetic converter",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "keywords": [
    "katakana",
    "tts",
    "japanese",
    "multilingual",
    "phonetics",
    "twitch"
  ],
  "author": "allpaqa",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  }
}
