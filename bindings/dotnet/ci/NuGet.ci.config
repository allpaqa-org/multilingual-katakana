<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet config used ONLY by .github/workflows/build-dotnet-matrix.yml (passed as
  -p:RestoreConfigFile=<this file>) when testing the packed nupkg.

  Package source mapping pins Allpaqa.* to the freshly packed local feed (<repo>/nupkg,
  relative to this file) and nothing else, so a same-version package that is later published
  to nuget.org can never be restored instead of the nupkg under test. Everything else
  (xunit, Microsoft.NET.Test.Sdk, ...) still comes from nuget.org.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local-nupkg" value="../../../nupkg" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local-nupkg">
      <package pattern="Allpaqa.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
